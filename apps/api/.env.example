# API server
PORT=8080
GIN_MODE=debug

# Database (pgx)
DATABASE_URL=postgres://canva:canva_secret@localhost:5432/canva_db?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# S3-compatible (AWS S3 or Cloudflare R2)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=canva-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_SSL=true

# Optional: custom CORS origin (default allows localhost)
CORS_ORIGIN=http://localhost:5173
